# OPENAI_API_KEY: chave da OpenAI (ChatGPT) — powers a IA do sistema:
# sugestão de categoria, conselho financeiro (Advisor), leitura de extrato em
# PDF/imagem e os bots (WhatsApp/Telegram). Modelo usado: gpt-4o.
# É segredo: fica só no servidor, nunca no navegador. Gere em platform.openai.com.
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Configuration (Fallback if firebase-applet-config.json is missing)
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID=""

# Credenciais usadas SOMENTE pelos scripts de seed/clean/verify (nunca vão pro bundle).
# Obrigatórias para rodar `npm run seed`, `npm run seed:clean`, `npm run seed:verify`.
SEED_EMAIL=""
SEED_PASSWORD=""

# --- Telegram Bot (só funciona DEPLOYADO com APP_URL público https) ---
# Token do bot criado no @BotFather. É segredo: nunca comitar preenchido.
TELEGRAM_BOT_TOKEN=""
# Segredo opcional do webhook: se definido, o servidor só aceita updates que
# tragam este valor no header (o setWebhook o registra automaticamente).
TELEGRAM_WEBHOOK_SECRET=""
# Token opcional para proteger o disparo manual/cron de alertas (/api/telegram/run-alerts).
ALERTS_CRON_TOKEN=""
